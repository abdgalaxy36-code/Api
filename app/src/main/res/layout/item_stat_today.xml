<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_bg"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="2dp">

    <TextView
        android:id="@+id/todayLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/accent"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="TODAY · WED 4 NOV 2026" />

    <TextView
        android:id="@+id/todayTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#FFFFFF"
        android:textSize="46sp"
        android:textStyle="bold"
        tools:text="41" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/sqDeparturesBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/square_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/departures"
                android:textColor="#8B949E"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sqDepartures"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/departed"
                android:textSize="30sp"
                android:textStyle="bold"
                tools:text="26" />

            <TextView
                android:id="@+id/sqDeparturesHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="#6B7785"
                android:textSize="11sp"
                tools:text="▸" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sqArrivalsBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@drawable/square_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/arrivals"
                android:textColor="#8B949E"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sqArrivals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/arrived"
                android:textSize="30sp"
                android:textStyle="bold"
                tools:text="15" />

            <TextView
                android:id="@+id/sqArrivalsHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="#6B7785"
                android:textSize="11sp"
                tools:text="▸" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
